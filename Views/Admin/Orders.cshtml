<h1>Order &amp; Payment Management (Admin)</h1>

<!-- Filter Bar -->
<div class="box">
    <form asp-controller="Admin" asp-action="Orders" method="get">
        <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 140px;">
                <label class="form-label">Order Status:</label>
                <select name="orderStatus" class="form-select">
                    <option value="All">All Order Statuses</option>
                    <option value="Pending" selected="@(currentOrderStatus == "Pending")">Pending</option>
                    <option value="Accepted" selected="@(currentOrderStatus == "Accepted")">Accepted</option>
                    <option value="Packed" selected="@(currentOrderStatus == "Packed")">Packed</option>
                    <option value="Shipped" selected="@(currentOrderStatus == "Shipped")">Shipped</option>
                    <option value="Delivered" selected="@(currentOrderStatus == "Delivered")">Delivered</option>
                    <option value="Cancelled" selected="@(currentOrderStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>

            <div style="flex: 1; min-width: 140px;">
                <label class="form-label">Payment Status:</label>
                <select name="paymentStatus" class="form-select">
                    <option value="All">All Payment Statuses</option>
                    <option value="Pending" selected="@(currentPaymentStatus == "Pending")">Pending</option>
                    <option value="Paid" selected="@(currentPaymentStatus == "Paid")">Paid</option>
                    <option value="Failed" selected="@(currentPaymentStatus == "Failed")">Failed</option>
                </select>
            </div>

            <div>
                <button type="submit" class="btn btn-primary" style="height: 31px;">Filter</button>
                <a asp-controller="Admin" asp-action="Orders" class="btn" style="height: 31px; display: inline-flex; align-items: center;">Reset</a>
            </div>
        </div>
    </form>
</div>

