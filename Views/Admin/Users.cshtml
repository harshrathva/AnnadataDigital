@model List<AgriDirect.Models.User>
@{
    ViewData["Title"] = "User Management";
}

<div style="margin-bottom: 10px;">
    <a asp-controller="Admin" asp-action="Dashboard">&larr; Back to Dashboard</a>
</div>

<h1>User Account Management</h1>

<div class="box">
    <table class="simple-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>#@u.Id</td>
                    <td><strong>@u.FullName</strong></td>
                    <td>@u.Email</td>
                    <td><span class="tag">@u.Role</span></td>
                    <td>@u.PhoneNumber</td>
                    <td>@u.Status</td>
                    <td>
                        @if (u.Role != "Admin")
                        {
                            @if (u.Status != "Active")
                            {
                                <form asp-controller="Admin" asp-action="UpdateUserStatus" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <input type="hidden" name="status" value="Active" />
                                    <button type="submit" class="btn btn-sm">Activate</button>
                                </form>
                            }
                            @if (u.Status != "Blocked")
                            {
                                <form asp-controller="Admin" asp-action="UpdateUserStatus" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <input type="hidden" name="status" value="Blocked" />
                                    <button type="submit" class="btn btn-sm" onclick="return confirm('Block this user?');">Block</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
