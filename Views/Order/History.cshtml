@model List<AgriDirect.Models.Order>
@{
    ViewData["Title"] = "Consumer Order Tracking";
}

<div style="margin-bottom: 10px;">
    <a asp-controller="Account" asp-action="ConsumerDashboard">&larr; Back to Dashboard</a>
</div>

<h1>Consumer Order Tracking</h1>

<div class="box">
    <div class="box-header">Order Tracking System (Pending Milestone 2)</div>
    <p style="color: #444; font-size: 13px; line-height: 1.5; margin-bottom: 10px;">
        Order placement checkout, live delivery status tracking (Pending, Shipped, Delivered), and rating reviews will be implemented in Project Milestone 2.
    </p>
    <div style="background: #f5f5f5; border: 1px dashed #999; padding: 10px; font-size: 13px; color: #555; margin-bottom: 15px;">
        &bull; <strong>Current Phase Deliverable:</strong> Direct farmer marketplace browsing, search &amp; filter, and transparent farm origin verification.
    </div>
    <a asp-controller="Marketplace" asp-action="Index" class="btn btn-primary">Browse Produce Marketplace &rarr;</a>
</div>
