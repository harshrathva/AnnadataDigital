@model AgriDirect.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h1>Account Profile</h1>

<div style="max-width: 550px; margin-top: 15px;">
    <div class="box">
        <div class="box-header">Profile Details (Role: @Model.Role)</div>

        <form asp-controller="Account" asp-action="Profile" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Role" />

            <div class="form-group">
                <label asp-for="FullName" class="form-label">Full Name:</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Email:</label>
                <input value="@Model.Email" class="form-control" disabled style="background: #eee;" />
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber" class="form-label">Phone Number:</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address" class="form-label">Address:</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-error"></span>
            </div>

            @if (Model.Role == "Farmer")
            {
                <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 12px; background: #fafafa;">
                    <div style="font-weight: bold; margin-bottom: 8px;">Farm Information</div>
                    <div class="form-group">
                        <label asp-for="FarmName" class="form-label">Farm Name:</label>
                        <input asp-for="FarmName" class="form-control" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label asp-for="FarmLocation" class="form-label">Farm Location:</label>
                        <input asp-for="FarmLocation" class="form-control" />
                    </div>
                </div>
            }

            <div style="margin-top: 15px;">
                <button type="submit" class="btn btn-primary">Save Profile</button>
            </div>
        </form>
    </div>
</div>
