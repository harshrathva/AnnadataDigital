@model AgriDirect.Models.Order
@using System.Security.Claims
@{
    ViewData["Title"] = $"Order #{Model.OrderNumber}";
    var currentUserId = 0;
    var uidClaim = User.FindFirst(ClaimTypes.NameIdentifier);
    if (uidClaim != null) int.TryParse(uidClaim.Value, out currentUserId);

    bool isFarmer = (Model.FarmerId == currentUserId);
    bool isAdmin = User.IsInRole("Admin");
}

<div style="margin-bottom: 10px;">
    <a href="javascript:history.back()">&larr; Back</a>
</div>

<h1>Order #@Model.OrderNumber</h1>

<div style="max-width: 650px; margin-top: 15px;">
    <div class="box">
        <div class="box-header">Order Summary</div>

        <table class="simple-table">
            <tr>
                <th style="width: 35%;">Order Number:</th>
                <td><strong>@Model.OrderNumber</strong></td>
            </tr>
            <tr>
                <th>Order Date:</th>
                <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>

            <tr>
                <th>Payment:</th>
                <td>@Model.PaymentMethod (<span class="tag">@Model.PaymentStatus</span>)</td>
            </tr>
            <tr>
                <th>Product:</th>
                <td>@Model.Product?.Name</td>
            </tr>
            <tr>
                <th>Quantity:</th>
                <td>@Model.Quantity @Model.Product?.Unit</td>
            </tr>
            <tr>
                <th>Unit Price:</th>
                <td>₹@Model.UnitPrice.ToString("0.##")</td>
            </tr>
            <tr>
                <th>Total Amount:</th>
                <td><strong>₹@Model.TotalAmount.ToString("0.##")</strong></td>
            </tr>
            <tr>
                <th>Buyer:</th>
                <td>@Model.Buyer?.FullName (@Model.Buyer?.PhoneNumber)</td>
            </tr>
            <tr>
                <th>Delivery Address:</th>
                <td>@Model.DeliveryAddress</td>
            </tr>
            <tr>
                <th>Farmer:</th>
                <td>@(Model.Farmer?.FarmName ?? Model.Farmer?.FullName)</td>
            </tr>
        </table>

        <!-- Milestone 2 Notice -->
        <div style="border-top: 1px solid #ccc; padding-top: 12px; margin-top: 12px; font-size: 13px; color: #555;">
            <em>* Live order dispatch tracking (Pending, Shipped, Delivered) and farmer review submission are scheduled for Milestone 2.</em>
        </div>
    </div>
</div>
