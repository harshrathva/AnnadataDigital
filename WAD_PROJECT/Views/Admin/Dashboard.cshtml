@model AgriDirect.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<p style="color: #666;">System administration, user verification, and catalog moderation overview.</p>

<!-- Quick Stats (Wireframe Boxes) -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-bottom: 20px;">
    <div class="box">
        <div style="font-size: 11px; color: #666; font-weight: bold;">TOTAL REGISTERED USERS</div>
        <div style="font-size: 22px; font-weight: bold; margin-top: 5px;">@Model.TotalUsers</div>
        <small style="color: #666;">Registered platform accounts</small>
    </div>
    <div class="box">
        <div style="font-size: 11px; color: #666; font-weight: bold;">FARMERS / PRODUCERS</div>
        <div style="font-size: 22px; font-weight: bold; margin-top: 5px;">@Model.TotalFarmers</div>
        <small style="color: #666;">Active agricultural sellers</small>
    </div>
    <div class="box">
        <div style="font-size: 11px; color: #666; font-weight: bold;">CONSUMERS / BUYERS</div>
        <div style="font-size: 22px; font-weight: bold; margin-top: 5px;">@Model.TotalConsumers</div>
        <small style="color: #666;">Direct produce purchasers</small>
    </div>
    <div class="box">
        <div style="font-size: 11px; color: #666; font-weight: bold;">MARKETPLACE PRODUCTS</div>
        <div style="font-size: 22px; font-weight: bold; margin-top: 5px;">@Model.TotalProducts</div>
        <small style="color: #666;">Available harvest listings</small>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
    <!-- Registered Users Overview -->
    <div class="box">
        <div class="box-header">Registered Users</div>
        <table class="simple-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.RecentUsers)
                {
                    <tr>
                        <td><strong>@u.FullName</strong></td>
                        <td>@u.Email</td>
                        <td><span class="tag">@u.Role</span></td>
                        <td>@u.Status</td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="margin-top: 10px;">
            <a asp-controller="Admin" asp-action="Users" class="btn btn-sm">Manage All Users &rarr;</a>
        </div>
    </div>

    <!-- Marketplace Products Overview -->
    <div class="box">
        <div class="box-header">Marketplace Produce Listings</div>
        <table class="simple-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Farmer</th>
                    <th>Price</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.RecentProducts)
                {
                    <tr>
                        <td><strong>@p.Name</strong></td>
                        <td>@p.Category</td>
                        <td>@(p.Farmer?.FarmName ?? p.Farmer?.FullName)</td>
                        <td>₹@p.Price.ToString("0.##") / @p.Unit</td>
                        <td><span class="tag">@p.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="margin-top: 10px;">
            <a asp-controller="Admin" asp-action="Products" class="btn btn-sm">Moderate Catalog &rarr;</a>
        </div>
    </div>
</div>

<!-- Milestone 2 Development Roadmap Box -->
<div class="box">
    <div class="box-header">Order Fulfillment Pipeline &amp; Review Moderation (Pending Implementation)</div>
    <p style="color: #444; font-size: 13px; line-height: 1.5; margin-bottom: 8px;">
        <strong>Project Milestone 2 Roadmap:</strong> Order tracking statuses (Pending, Packed, Shipped, Delivered) and consumer review moderation are scheduled for implementation in Milestone 2.
    </p>
    <div style="background: #f5f5f5; border: 1px dashed #999; padding: 10px; font-size: 13px; color: #555;">
        &bull; <strong>Current Administrative Capabilities:</strong> User account registration, role management (Farmer / Consumer / Admin), account activation/suspension, and marketplace product catalog moderation.
    </div>
</div>
