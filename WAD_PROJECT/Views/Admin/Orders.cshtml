@model List<AgriDirect.Models.Order>
@{
    ViewData["Title"] = "Orders & Payments";
}

<div style="margin-bottom: 10px;">
    <a asp-controller="Admin" asp-action="Dashboard">&larr; Back to Dashboard</a>
</div>

<h1>Order &amp; Payment Management</h1>

<div class="box">
    <div class="box-header">Order Fulfillment &amp; Payment Reconciliation (Pending Milestone 2)</div>
    <p style="color: #444; font-size: 13px; line-height: 1.5; margin-bottom: 10px;">
        Central order tracking (Pending, Shipped, Delivered) and payment reconciliation are scheduled for Milestone 2.
    </p>
    <div style="background: #f5f5f5; border: 1px dashed #999; padding: 10px; font-size: 13px; color: #555; margin-bottom: 15px;">
        &bull; <strong>Current Administrative Scope:</strong> Platform user account management (Farmer &amp; Consumer moderation) and marketplace product catalog review.
    </div>
    <div style="display: flex; gap: 10px;">
        <a asp-controller="Admin" asp-action="Users" class="btn btn-primary">Manage Users</a>
        <a asp-controller="Admin" asp-action="Products" class="btn">Moderate Catalog</a>
    </div>
</div>
